# --- Media (never commit lecture material) ---
*.mp4
*.webm
*.mkv
*.mov
*.m4v
*.avi
*.wav
*.mp3
*.m4a
*.flac

# Test fixtures are the only media allowed in the repository. The subtitle
# fixtures are synthetic placeholder text written for the tests, never a
# real transcript.
# The `**` form matters: a plain `tests/fixtures/*.srt` leaves fixtures that
# live in a per-case subfolder ignored, which silently drops them from a clone.
!tests/fixtures/**/*.mp4
!tests/fixtures/**/*.srt
!tests/fixtures/**/*.vtt

# --- OS ---
Thumbs.db
.DS_Store
